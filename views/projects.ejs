<!DOCTYPE html> 
<html>
	<head>
		<title>Our Portfolio | Vault</title>
		<link href="css/styles.css" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/3.7.2/animate.min.css"/>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
		<link rel="stylesheet" href="css/back-to-top.css">
		<link rel="stylesheet" href="css/lightbox.css">
		<link rel="stylesheet" href="css/loader.css">
		<link rel="stylesheet" href="css/gallery.css">
	</head>
	
	<body>
		<div id="page-loader">
		   <div class="team-loader">
				<div id="loader-text" class="loader-text">
				   <span>V</span><span>A</span><span>U</span><span>L</span><span>T</span>
				</div>
			</div>
		</div> 
		
		<a id="button" class="show"></a>
		
		<header>
			<div class="topbar wow fadeInDown" data-wow-delay="1.8s">
				<div class="wrapper">
					<div class="tl">
						<ul>
						  <li><i class="fa-solid fa-map-pin"></i>Delhi, India</li>
						  <li><i class="fa-solid fa-phone"></i>+91 8972387745</li>
						</ul>
					</div>
					<div class="tr">
						<ul>
						  <li><i class="fa-regular fa-clock"></i>Mon - Sat : 10AM - 7PM</li>
						  <li><i class="fa-regular fa-envelope"></i>vaultstudio@gmail.com</li>
						</ul>
					</div>
					<div class="c"></div>
				</div>
			</div>
			
			<div class="header wow fadeInDown" data-wow-delay="1.8s">
				<div class="wrapper">
					<div class="h1">
						<a href="index.html"><img src="images/logo-1.png" alt="Vault Logo"/></a>
					</div>
					<nav>
						<ul>
						  <li><a href="index.html" target="_blank"><i class="fa-solid fa-house"></i> Home</a></li>
						  <li><a href="about.html" target="_blank"><i class="fa-solid fa-building"></i> About</a></li>
						  <li><a href="services.html" target="_blank"><i class="fa-solid fa-compass-drafting"></i> Services</a></li>
						  <li><a href="/projects" target="_blank"><i class="fa-solid fa-layer-group"></i> Projects</a></li>
						  <li><a href="contact.html" target="_blank"><i class="fa-solid fa-phone"></i> Contact</a></li>
							<li><a href="/admin-login" target="_blank"><i class="fa-solid fa-user-shield"></i> Admin</a></li>
						</ul>
					</nav>
					<div class="c"></div>
				</div>
			</div>
		</header>

		<section>
			<div class="projects-banner">
				<div class="wrapper">
					<div class="projects-banner-content">
						<span>Our Portfolio</span>
						<h1>
							Spaces Designed<br>
							To Be Remembered
						</h1>
						<p>
							A curated collection of luxury residences,
							commercial spaces and timeless interiors crafted
							with precision, elegance and innovation.
						</p>
					</div>
				</div>
			</div>
			<section id="vault-projects">
				<div class="project-container">
					<div id="vault-gallery">
						<div class="project-grid">
							<div class="project-card">
								<div class="project-image-box">
									<a href="images/h1.jpg"><img src="images/h1.jpg" alt=""></a>
									<div class="project-overlay">
										<i class="fa fa-plus-circle" aria-hidden="true"></i>
									</div>
								</div>
							</div>
							<div class="project-card">
								<div class="project-image-box">
									<a href="images/h4.jpg"><img src="images/h4.jpg" alt=""></a>
									<div class="project-overlay">
										<i class="fa fa-plus-circle" aria-hidden="true"></i>
									</div>
								</div>
							</div>
							<div class="project-card">
								<div class="project-image-box">
									<a href="images/pro2.jpg"><img src="images/pro2.jpg" alt=""></a>
									<div class="project-overlay">
										<i class="fa fa-plus-circle" aria-hidden="true"></i>
									</div>
								</div>
							</div>
							<div class="project-card">
								<div class="project-image-box">
									<a href="images/h8.jpg"><img src="images/h8.jpg" alt=""></a>
									<div class="project-overlay">
										<i class="fa fa-plus-circle" aria-hidden="true"></i>
									</div>
								</div>
							</div>
							<div class="project-card">
								<div class="project-image-box">
									<a href="images/h2.jpg"><img src="images/h2.jpg" alt=""></a>
									<div class="project-overlay">
										<i class="fa fa-plus-circle" aria-hidden="true"></i>
									</div>
								</div>
							</div>
							<div class="project-card">
								<div class="project-image-box">
									<a href="images/pro3.jpg"><img src="images/pro3.jpg" alt=""></a>
									<div class="project-overlay">
										<i class="fa fa-plus-circle" aria-hidden="true"></i>
									</div>
								</div>
							</div>
							<div class="project-card">
								<div class="project-image-box">
									<a href="images/h12.jpg"><img src="images/h12.jpg" alt=""></a>
									<div class="project-overlay">
										<i class="fa fa-plus-circle" aria-hidden="true"></i>
									</div>
								</div>
							</div>
							<div class="project-card">
								<div class="project-image-box">
									<a href="images/h2.jpg"><img src="images/h2.jpg" alt=""></a>
									<div class="project-overlay">
										<i class="fa fa-plus-circle" aria-hidden="true"></i>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="dynamic-projects">
				<div class="wrapper">

					<div class="section-title">
						<span>Latest Projects</span>
						<h2>Projects Added By Our Team</h2>
					</div>

					<div class="dynamic-project-grid">
						<% projects.forEach(project => { %>
							<div class="dynamic-project-card">
								<div class="dynamic-image">
									<img src="/images/<%= project.coverImage %>" alt="<%= project.title %>">
								</div>

								<div class="dynamic-content">
									<h3><%= project.title %></h3>
									<p class="location">
										<i class="fa-solid fa-location-dot"></i>
										<%= project.location %>
									</p>
									<p class="category">
										<%= project.category %>
									</p>
									<p class="budget">
										Budget: <%= project.budget %>
									</p>
									<p class="description">
										<%= project.description %>
									</p>
								</div>
							</div>
						<% }) %>
					</div>
				</div>
			</section>
		</section>


		<footer>
			<div class="footer">
				<div class="wrapper">
					<div class="fbox">
						<h2>About Us</h2>
						<p>VAULT is a luxury architecture and interior design studio creating refined residential and commercial spaces that blend timeless elegance, modern aesthetics, and functional sophistication.</p>
					</div>
					<div class="fbox">
						<h3>Quick Links</h3>
						<div class="fbox2">
							<ul>
								<li><a href="index.html">Home</a></li>
								<li><a href="about.html">About</a></li>
								<li><a href="services.html">Services</a></li>
								<li><a href="projects.html">Projects</a></li>
								<li><a href="contact.html">Contact</a></li>
							</ul>
						</div>
					</div>
					<div class="fbox">
						<h3>Contact</h3>
						<ul>
							<li><i class="fa-solid fa-map-pin"></i> Delhi, India</li>
							<li><i class="fa-solid fa-phone"></i> +91 8972387745</li>
							<li><i class="fa-solid fa-envelope"></i> vaultstudio@gmail.com</li>
						</ul>
					</div>
					<div class="fbox">
						<h3>Follow Us</h3>
						<div class="fbox3">
							<a href="#"><i class="fa-brands fa-instagram"></i></a>
							<a href="#"><i class="fa-brands fa-pinterest"></i></a>
							<a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
						</div>
					</div>
					<div class="c"></div>
				</div>
			</div>
			<div class="copy">
				<div class="wrapper">
					<div class="copyright">
						<p>All rights reserved. © 2026 Developed by Smaranika</p>
					</div>
					<div class="policy">
						<a href="#">Privacy Policy</a>
						<p> | </p> 
						<a href="#">Terms & Conditions</a>
					</div>
					<div class="c"></div>
				</div>
			</div>
		</footer>

		<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>
		<script src="js/back-to-top.js"></script>			
		<script src="js/lightbox.js"></script>
		<script src="js/gallery.js"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/2.1.3/TweenMax.min.js"></script> 
		<script src="js/loader.js"></script>
				
		<script>
			wow = new WOW( {
				boxClass: 'wow',
				animateClass: 'animated',
				offset: 100
				}
			);
			wow.init();
		</script>	
	</body>
</html>